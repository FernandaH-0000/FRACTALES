#include "../turtlec.h"
#include <math.h>

void levy(Turtle *t, float length, int depth){

    // Caso base
    if(depth == 0){
        turtleForward(t, length);
        return;
    }
    // Girar 45° a la izquierda
    turtleLeft(t, 45.0f);

    // Primera mitad de la curva
    levy(t, length / sqrt(2.0f), depth - 1);

    // Girar 90° a la derecha
    turtleRight(t, 90.0f);

    // Segunda mitad de la curva
    levy(t, length / sqrt(2.0f), depth - 1);

    // Recuperar orientación original
    turtleLeft(t, 45.0f);
}

int main(){

    TurtleApp *app = turtleAppCreate(800, 600, "Curva de Levy");

    if(app == NULL)
        return 1;

    Turtle *t = turtleAppGetTurtle(app);

    turtleSetSpeed(t, 10.0f);

    // Posicionar la tortuga
    turtlePenUp(t);
    turtleGoTo(t, 200.0f, 300.0f);
    turtlePenDown(t);

    turtleSetColor(t, 0, 0, 255);

    // Dibujar curva
    levy(t, 400.0f, 12);

    turtleAppRun(app);
    turtleAppDestroy(app);

    return 0;
}

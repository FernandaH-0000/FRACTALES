#include <stdio.h>
#include <string.h>

typedef struct{
    char island[40];
    int day;
    int month;
    int danger;
} Record;

void swap(Record *a, Record *b){
    Record temp=*a;
    *a=*b;
    *b=temp;
}

int compareRecords(Record a, Record b){

    int cmp = strcmp(a.island,b.island);

    if(cmp != 0)
        return cmp > 0;

    if(a.month != b.month)
        return a.month > b.month;

    return a.day > b.day;
}

void insertionSort(Record arr[], int n){

    for(int i=1;i<n;i++){
        int j=i;

        while(j>0 &&
              compareRecords(arr[j-1],arr[j])){
            swap(&arr[j-1],&arr[j]);
            j--;
        }
    }
}

int main(){

    int n;
    scanf("%d",&n);

    Record r[1000];

    for(int i=0;i<n;i++){
        scanf("%s %d %d %d",
              r[i].island,
              &r[i].day,
              &r[i].month,
              &r[i].danger);
    }

    insertionSort(r,n);

    int i=0;

    while(i<n){

        int count=0;
        int maxDanger=0;
        char island[40];

        strcpy(island,r[i].island);

        while(i<n &&
              strcmp(r[i].island,island)==0){

            count++;

            if(r[i].danger > maxDanger)
                maxDanger = r[i].danger;

            i++;
        }

        printf("%s %d %d\n",
               island,
               count,
               maxDanger);
    }

    return 0;
}


